import proofs.FiniteCopy.Source

namespace FiniteCopy
noncomputable def normSq (x : Point) : ℝ := x 0^2+x 1^2+x 2^2+x 3^2

noncomputable def lowEnergy (x : Point) : ℝ :=
  (1115801/1000000 : ℝ)*x 0*x 0 + (-153427/125000 : ℝ)*x 0*x 1 + (2346047/500000 : ℝ)*x 0*x 2 + (688977/100000 : ℝ)*x 0*x 3 + (1111499/1000000 : ℝ)*x 1*x 1 + (-2339313/500000 : ℝ)*x 1*x 2 + (-214649/31250 : ℝ)*x 1*x 3 + (6767757/1000000 : ℝ)*x 2*x 2 + (5089403/250000 : ℝ)*x 2*x 3 + (15517433/1000000 : ℝ)*x 3*x 3

theorem lowEnergy_lower (x : Point) : (1/200 : ℝ)*normSq x ≤ lowEnergy x := by
  have hid : lowEnergy x-(1/200 : ℝ)*normSq x =
    (1110801/1000000 : ℝ)*((1/1 : ℝ)*x 0 + (-613708/1110801 : ℝ)*x 1 + (2346047/1110801 : ℝ)*x 2 + (1148295/370267 : ℝ)*x 3)^2 + (170492537287/222160200000 : ℝ)*((1/1 : ℝ)*x 1 + (-1158723407437/852462686435 : ℝ)*x 2 + (-1700763698004/852462686435 : ℝ)*x 3)^2 + (332395353690504611/852462686435000000 : ℝ)*((1/1 : ℝ)*x 2 + (700645551197815437/332395353690504611 : ℝ)*x 3)^2 + (13865730014610567708741/332395353690504611000000 : ℝ)*((1/1 : ℝ)*x 3)^2 := by
    unfold lowEnergy normSq
    ring
  have hn : 0 ≤ lowEnergy x-(1/200 : ℝ)*normSq x := by
    rw [hid]
    positivity
  linarith only [hn]

theorem lowEnergy_upper (x : Point) : lowEnergy x ≤ (24/1 : ℝ)*normSq x := by
  have hid : (24/1 : ℝ)*normSq x-lowEnergy x =
    (22884199/1000000 : ℝ)*((1/1 : ℝ)*x 0 + (613708/22884199 : ℝ)*x 1 + (-2346047/22884199 : ℝ)*x 2 + (-3444885/22884199 : ℝ)*x 3)^2 + (104681674837287/4576839800000 : ℝ)*((1/1 : ℝ)*x 1 + (54973092027563/523408374186435 : ℝ)*x 2 + (80707280381996/523408374186435 : ℝ)*x 3)^2 + (8761556052354730710389/523408374186435000000 : ℝ)*((1/1 : ℝ)*x 2 + (-5706398383243465880437/8761556052354730710389 : ℝ)*x 3)^2 + (2798958729179750940677848741/8761556052354730710389000000 : ℝ)*((1/1 : ℝ)*x 3)^2 := by
    unfold lowEnergy normSq
    ring
  have hn : 0 ≤ (24/1 : ℝ)*normSq x-lowEnergy x := by
    rw [hid]
    positivity
  linarith only [hn]

