def graph : Hypergraph.PairAssembly (Fin 9) (Fin 9) where
  src := fun i => if i = 0 then 0 else if i = 1 then 1 else if i = 2 then 2 else if i = 3 then 3 else if i = 4 then 0 else if i = 5 then 4 else if i = 6 then 5 else if i = 7 then 6 else 7
  dst := fun i => if i = 0 then 1 else if i = 1 then 2 else if i = 2 then 3 else if i = 3 then 8 else if i = 4 then 4 else if i = 5 then 5 else if i = 6 then 6 else if i = 7 then 7 else 8
  distinct := by intro e; fin_cases e <;> decide

def deficit : Fin 9 → ℚ := fun i => if i = 0 then (1/1 : ℚ) else if i = 1 then (83/50 : ℚ) else if i = 2 then (69/25 : ℚ) else if i = 3 then (459/100 : ℚ) else if i = 4 then (1501/1000 : ℚ) else if i = 5 then (1127/500 : ℚ) else if i = 6 then (3383/1000 : ℚ) else if i = 7 then (1269/250 : ℚ) else (191/25 : ℚ)
def z (v : Fin 9) : ℚ := 1-deficit v/10000

theorem unit_certificate : rationalFamilyCheck graph (fun _ => 1) (fun _ => 1) z
    (fun _ => 9/10) (fun _ => 1) = true := by
  apply rationalFamilyCheck_eq_true
  · intro v
    fin_cases v
    · change (9/10 : ℚ) ≤ (1-(1/1 : ℚ)/10000) ∧ (1-(1/1 : ℚ)/10000) ≤ 1
      norm_num
    · change (9/10 : ℚ) ≤ (1-(83/50 : ℚ)/10000) ∧ (1-(83/50 : ℚ)/10000) ≤ 1
      norm_num
    · change (9/10 : ℚ) ≤ (1-(69/25 : ℚ)/10000) ∧ (1-(69/25 : ℚ)/10000) ≤ 1
      norm_num
    · change (9/10 : ℚ) ≤ (1-(459/100 : ℚ)/10000) ∧ (1-(459/100 : ℚ)/10000) ≤ 1
      norm_num
    · change (9/10 : ℚ) ≤ (1-(1501/1000 : ℚ)/10000) ∧ (1-(1501/1000 : ℚ)/10000) ≤ 1
      norm_num
    · change (9/10 : ℚ) ≤ (1-(1127/500 : ℚ)/10000) ∧ (1-(1127/500 : ℚ)/10000) ≤ 1
      norm_num
    · change (9/10 : ℚ) ≤ (1-(3383/1000 : ℚ)/10000) ∧ (1-(3383/1000 : ℚ)/10000) ≤ 1
      norm_num
    · change (9/10 : ℚ) ≤ (1-(1269/250 : ℚ)/10000) ∧ (1-(1269/250 : ℚ)/10000) ≤ 1
      norm_num
    · change (9/10 : ℚ) ≤ (1-(191/25 : ℚ)/10000) ∧ (1-(191/25 : ℚ)/10000) ≤ 1
      norm_num
  · intro e
    fin_cases e
    · change rationalEdgeCheck 1 1 (1-(1/1 : ℚ)/10000) (1-(83/50 : ℚ)/10000) = true
      norm_num [rationalEdgeCheck]
    · change rationalEdgeCheck 1 1 (1-(83/50 : ℚ)/10000) (1-(69/25 : ℚ)/10000) = true
      norm_num [rationalEdgeCheck]
    · change rationalEdgeCheck 1 1 (1-(69/25 : ℚ)/10000) (1-(459/100 : ℚ)/10000) = true
      norm_num [rationalEdgeCheck]
    · change rationalEdgeCheck 1 1 (1-(459/100 : ℚ)/10000) (1-(191/25 : ℚ)/10000) = true
      norm_num [rationalEdgeCheck]
    · change rationalEdgeCheck 1 1 (1-(1/1 : ℚ)/10000) (1-(1501/1000 : ℚ)/10000) = true
      norm_num [rationalEdgeCheck]
    · change rationalEdgeCheck 1 1 (1-(1501/1000 : ℚ)/10000) (1-(1127/500 : ℚ)/10000) = true
      norm_num [rationalEdgeCheck]
    · change rationalEdgeCheck 1 1 (1-(1127/500 : ℚ)/10000) (1-(3383/1000 : ℚ)/10000) = true
      norm_num [rationalEdgeCheck]
    · change rationalEdgeCheck 1 1 (1-(3383/1000 : ℚ)/10000) (1-(1269/250 : ℚ)/10000) = true
      norm_num [rationalEdgeCheck]
    · change rationalEdgeCheck 1 1 (1-(1269/250 : ℚ)/10000) (1-(191/25 : ℚ)/10000) = true
      norm_num [rationalEdgeCheck]

theorem unit_source :
    (∀ v, (9/10 : ℝ) ≤ (z v : ℝ) ∧ (z v : ℝ) ≤ 1) ∧
    ∀ e, (WeightedSource.motif graph (fun _ => rationalFactors 1 1 (by norm_num) (by norm_num)) e).IsPAC ∧
      (WeightedSource.motif graph (fun _ => rationalFactors 1 1 (by norm_num) (by norm_num)) e).Productive
        ((WeightedSource.network graph (fun _ => rationalFactors 1 1 (by norm_num) (by norm_num))).current
          (fun v => (z v : ℝ))) := by
  simpa using rationalFamilyCheck_sound graph (fun _ => 1) (fun _ => 1) z (fun _ => 9/10)
    (fun _ => 1) (fun _ => by norm_num) (fun _ => by norm_num) unit_certificate

theorem nongraded : ¬ ∃ rank : Fin 9 → ℤ, ∀ e, rank (graph.dst e) = rank (graph.src e)+1 := by
  rintro ⟨rank,h⟩
  have h0 := h 0
  change rank 1 = rank 0+1 at h0
  have h1 := h 1
  change rank 2 = rank 1+1 at h1
  have h2 := h 2
  change rank 3 = rank 2+1 at h2
  have h3 := h 3
  change rank 8 = rank 3+1 at h3
  have h4 := h 4
  change rank 4 = rank 0+1 at h4
  have h5 := h 5
  change rank 5 = rank 4+1 at h5
  have h6 := h 6
  change rank 6 = rank 5+1 at h6
  have h7 := h 7
  change rank 7 = rank 6+1 at h7
  have h8 := h 8
  change rank 8 = rank 7+1 at h8
  omega

