import proofs.HordijkSteelThreshold.NucleusAmplification

namespace HordijkSteelThreshold

open RAF.Polymer

/-- Fixed-split concatenation is an embedding of a pair of binary word
languages into the product layer. -/
def concatWordEmbedding (i j : Nat) :
    (Word i × Word j) ↪ Word (i + j) where
  toFun uv := Fin.cast (pow_add 2 i j).symm (finProdFinEquiv uv)
  inj' := by
    intro a b hab
    apply finProdFinEquiv.injective
    apply Fin.ext
    simpa using congrArg Fin.val hab

def concatWordImage {i j : Nat} (A : Finset (Word i))
    (B : Finset (Word j)) : Finset (Word (i + j)) :=
  (A.product B).map (concatWordEmbedding i j)

@[simp] theorem card_concatWordImage {i j : Nat} (A : Finset (Word i))
    (B : Finset (Word j)) :
    (concatWordImage A B).card = A.card * B.card := by
  simp [concatWordImage]

def wordAddCommEmbedding (i j : Nat) : Word (j + i) ↪ Word (i + j) where
  toFun w := Fin.cast (congrArg (fun k => 2 ^ k) (Nat.add_comm j i)) w
  inj' := by
    intro a b hab
    apply Fin.ext
    simpa using congrArg Fin.val hab

/-- Length-`i+j` targets for which a fixed word is either the left or right
factor at the corresponding split. -/
def fixedFactorCone {i j : Nat} (u : Word i) : Finset (Word (i + j)) :=
  concatWordImage {u} Finset.univ ∪
    (concatWordImage Finset.univ {u}).map (wordAddCommEmbedding i j)

/-- A fixed length-`i` factor influences at most two `2^j` words in the
length-`i+j` target layer. This is the exact `2^{-i}` layer-density coefficient
behind the leave-one-target cavity estimate. -/
theorem card_fixedFactorCone_le {i j : Nat} (u : Word i) :
    (fixedFactorCone (j := j) u).card ≤ 2 * 2 ^ j := by
  calc
    (fixedFactorCone (j := j) u).card ≤
        (concatWordImage {u} (Finset.univ : Finset (Word j))).card +
          ((concatWordImage (Finset.univ : Finset (Word j)) {u}).map
            (wordAddCommEmbedding i j)).card :=
      Finset.card_union_le _ _
    _ = 2 * 2 ^ j := by simp [two_mul]

/-- The union of all length-`i` factor cones generated by a deleted set `D`
has layer density at most `2 * |D| / 2^i`. -/
theorem card_biUnion_fixedFactorCone_le {i j : Nat} (D : Finset (Word i)) :
    (D.biUnion fun u => fixedFactorCone (j := j) u).card ≤
      D.card * (2 * 2 ^ j) := by
  exact Finset.card_biUnion_le_card_mul D
    (fun u => fixedFactorCone (j := j) u) (2 * 2 ^ j)
    (fun u _ => card_fixedFactorCone_le u)

end HordijkSteelThreshold
