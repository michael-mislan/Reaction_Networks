import proofs.HordijkSteelThreshold.GatewayCavity
import proofs.HordijkSteelThreshold.CatalystPoolBlocks

namespace HordijkSteelThreshold

open RAF RAF.Polymer RAF.Concrete

/-- Retain only nongateway catalysis coordinates whose catalyst belongs to a
specified prospective molecule pool. -/
def restrictBulkToPool {n : Nat} (bulk : Set (NonseedCoord n))
    (C : Finset (Molecule n)) : Set (NonseedCoord n) :=
  {z | z ∈ bulk ∧ z.1 ∈ C}

@[simp] theorem mem_restrictBulkToPool {n : Nat} (bulk : Set (NonseedCoord n))
    (C : Finset (Molecule n)) (z : NonseedCoord n) :
    z ∈ restrictBulkToPool bulk C ↔ z ∈ bulk ∧ z.1 ∈ C := by
  rfl

theorem restrictBulkToPool_mono {n : Nat} {bulk bulk' : Set (NonseedCoord n)}
    {C D : Finset (Molecule n)} (hbulk : bulk ⊆ bulk') (hCD : C ⊆ D) :
    restrictBulkToPool bulk C ⊆ restrictBulkToPool bulk' D := by
  intro z hz
  exact ⟨hbulk hz.1, hCD hz.2⟩

theorem bulkCatalysis_mono {n : Nat} {bulk bulk' : Set (NonseedCoord n)}
    (hbulk : bulk ⊆ bulk') {x : Molecule n} {r : Reaction n}
    (hcat : bulkCatalysis bulk x r) : bulkCatalysis bulk' x r := by
  by_cases hseed : RevSeedReaction (binaryPolymerCRS n 2) r
  · simp [bulkCatalysis, hseed] at hcat
  · have hc : (x, ⟨r, hseed⟩) ∈ bulk := by
      simpa [bulkCatalysis, hseed] using hcat
    simpa [bulkCatalysis, hseed] using hbulk hc

theorem IsGatewaySeededRAF.mono_bulk {n : Nat}
    {bulk bulk' : Set (NonseedCoord n)} (hbulk : bulk ⊆ bulk')
    {J : Finset (PolymerSeedReaction n 2)} {S : Finset (Reaction n)}
    (hS : IsGatewaySeededRAF bulk J S) :
    IsGatewaySeededRAF bulk' J S := by
  refine ⟨hS.1, hS.2.1, ?_⟩
  intro r hr
  rcases hS.2.2 r hr with hforced | ⟨x, k, hx, hcat⟩
  · exact Or.inl hforced
  · exact Or.inr ⟨x, k, hx, bulkCatalysis_mono hbulk hcat⟩

theorem gatewaySeededMaxRAF_mono_bulk {n : Nat}
    {bulk bulk' : Set (NonseedCoord n)} (hbulk : bulk ⊆ bulk')
    (J : Finset (PolymerSeedReaction n 2)) :
    gatewaySeededMaxRAF bulk J ⊆ gatewaySeededMaxRAF bulk' J := by
  classical
  intro r hr
  simp only [gatewaySeededMaxRAF, Finset.mem_biUnion] at hr ⊢
  obtain ⟨S, hSF, hrS⟩ := hr
  have hS : IsGatewaySeededRAF bulk J S :=
    (mem_gatewaySeededRAFFamily bulk J S).mp hSF
  exact ⟨S, (mem_gatewaySeededRAFFamily bulk' J S).mpr
    (hS.mono_bulk hbulk), hrS⟩

/-- The exact reversible seeded maxRAF when only catalysts in `C` may supply
bulk support.  Cleavage and ligation remain unchanged. -/
noncomputable def poolSeededMaxRAF {n : Nat} (bulk : Set (NonseedCoord n))
    (J : Finset (PolymerSeedReaction n 2)) (C : Finset (Molecule n)) :
    Finset (Reaction n) :=
  gatewaySeededMaxRAF (restrictBulkToPool bulk C) J

theorem poolSeededMaxRAF_mono {n : Nat} {bulk bulk' : Set (NonseedCoord n)}
    {J K : Finset (PolymerSeedReaction n 2)} {C D : Finset (Molecule n)}
    (hbulk : bulk ⊆ bulk') (hJK : J ⊆ K) (hCD : C ⊆ D) :
    poolSeededMaxRAF bulk J C ⊆ poolSeededMaxRAF bulk' K D := by
  exact (gatewaySeededMaxRAF_mono_bulk
    (restrictBulkToPool_mono hbulk hCD) J).trans
      (gatewaySeededMaxRAF_mono_forced _ hJK)

theorem poolSeededMaxRAF_subset_full {n : Nat} (bulk : Set (NonseedCoord n))
    (J : Finset (PolymerSeedReaction n 2)) (C : Finset (Molecule n)) :
    poolSeededMaxRAF bulk J C ⊆ gatewaySeededMaxRAF bulk J := by
  exact gatewaySeededMaxRAF_mono_bulk (fun _ hz => hz.1) J

/-- A pool is self-consistent when its restricted seeded family is nonempty
and every proposed pool molecule is generated by the resulting reversible
maxRAF. -/
def ReversiblePoolSelfConsistent {n : Nat} (bulk : Set (NonseedCoord n))
    (J : Finset (PolymerSeedReaction n 2)) (C : Finset (Molecule n)) : Prop :=
  (gatewaySeededRAFFamily (restrictBulkToPool bulk C) J).Nonempty ∧
    ∀ x ∈ C, ∃ k, x ∈ revClosureAt (binaryPolymerCRS n 2)
      (poolSeededMaxRAF bulk J C) k

/-- The fixed-pool construction is source-faithful: a nonempty restricted
family produces an ordinary seeded RAF for the original bulk sample. -/
theorem poolSeededMaxRAF_isGatewaySeededRAF {n : Nat}
    {bulk : Set (NonseedCoord n)} {J : Finset (PolymerSeedReaction n 2)}
    {C : Finset (Molecule n)}
    (hne : (gatewaySeededRAFFamily (restrictBulkToPool bulk C) J).Nonempty) :
    IsGatewaySeededRAF bulk J (poolSeededMaxRAF bulk J C) := by
  exact (isGatewaySeededRAF_maxRAF _ J hne).mono_bulk (fun _ hz => hz.1)

/-- Every non-forced reaction in the pool maxRAF has a catalyst that is both
in the declared pool and in the reversible closure. -/
theorem poolSeededMaxRAF_supported_by_pool {n : Nat}
    {bulk : Set (NonseedCoord n)} {J : Finset (PolymerSeedReaction n 2)}
    {C : Finset (Molecule n)}
    (hne : (gatewaySeededRAFFamily (restrictBulkToPool bulk C) J).Nonempty)
    {r : Reaction n} (hr : r ∈ poolSeededMaxRAF bulk J C) :
    GatewayForced J r ∨ ∃ x ∈ C, ∃ k,
      x ∈ revClosureAt (binaryPolymerCRS n 2) (poolSeededMaxRAF bulk J C) k ∧
      bulkCatalysis bulk x r := by
  have hmax := isGatewaySeededRAF_maxRAF
    (restrictBulkToPool bulk C) J hne
  rcases hmax.2.2 r hr with hforced | ⟨x, k, hx, hcat⟩
  · exact Or.inl hforced
  · right
    by_cases hseed : RevSeedReaction (binaryPolymerCRS n 2) r
    · simp [bulkCatalysis, hseed] at hcat
    · have hcat' : (x, ⟨r, hseed⟩) ∈ restrictBulkToPool bulk C := by
        simpa [bulkCatalysis, hseed] using hcat
      exact ⟨x, hcat'.2, k, hx, bulkCatalysis_mono
        (fun _ hz => hz.1) hcat⟩

/-- A self-consistent pool supplies, and is generated by, an exact reversible
seeded RAF in the original source model. -/
theorem ReversiblePoolSelfConsistent.realizes_source {n : Nat}
    {bulk : Set (NonseedCoord n)} {J : Finset (PolymerSeedReaction n 2)}
    {C : Finset (Molecule n)} (hC : ReversiblePoolSelfConsistent bulk J C) :
    IsGatewaySeededRAF bulk J (poolSeededMaxRAF bulk J C) ∧
      (∀ x ∈ C, ∃ k, x ∈ revClosureAt (binaryPolymerCRS n 2)
        (poolSeededMaxRAF bulk J C) k) := by
  exact ⟨poolSeededMaxRAF_isGatewaySeededRAF hC.1, hC.2⟩

end HordijkSteelThreshold
