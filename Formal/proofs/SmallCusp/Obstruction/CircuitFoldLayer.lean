def IsCircuitFoldLayerNetwork (C : CodedBimolNetwork) : Prop :=
  ∃ R ∈ circuitFoldLayerRecords, C.reaction = R.network.reaction

theorem codedNetwork_eq_of_reaction_eq (C D : CodedBimolNetwork)
    (h : C.reaction = D.reaction) : C.toNetwork = D.toNetwork := by
  cases C with
  | mk reaction noSelf injective =>
    cases D with
    | mk reaction' noSelf' injective' =>
      simp only at h
      subst reaction'
      rfl

theorem isCircuitFoldLayerNetwork_excludes_cusp (C : CodedBimolNetwork)
    (hC : IsCircuitFoldLayerNetwork C) :
    ¬ AdmitsTransverseCusp C.toNetwork := by
  rcases hC with ⟨R, hR, hreactions⟩
  have hnetwork : C.toNetwork = R.network.toNetwork :=
    codedNetwork_eq_of_reaction_eq C R.network hreactions
  rw [hnetwork]
  exact R.excludesCusp

theorem circuitFoldLayerRecords_length : circuitFoldLayerRecords.length = 744 := by
  native_decide

