theorem high_energy_eq (y : Fin 6 → ℝ) : quadratic highP y = highEnergy y := by
  norm_num [quadratic,highP,highEnergy,sum_six,sum_nine]
  ring

theorem high_symmetric (i j : Fin 6) : highP i j = highP j i := by
  fin_cases i <;> fin_cases j <;> norm_num [highP]

theorem high_binding_00 (m : Fin 9 → ℝ) (hm : m 8 = 1) :
    affine (highCoefficients 0 0) m =
      (-(highP*secant m+(secant m).transpose*highP)) 0 0 := by
  simp only [affine,Matrix.mul_apply,Matrix.transpose_apply,Matrix.add_apply,Matrix.neg_apply,sum_six,sum_nine]
  change (199/1250000:ℝ)*m 0+(0:ℝ)*m 1+(0:ℝ)*m 2+(0:ℝ)*m 3+(0:ℝ)*m 4+(0:ℝ)*m 5+(0:ℝ)*m 6+(0:ℝ)*m 7+(51/50:ℝ)*m 8 = -(((109/100:ℝ)*(-2-(4/100000)*m 0)+(-9/5:ℝ)*(1+(2/100000)*m 0)+(347/100:ℝ)*(1)+(519/100:ℝ)*(0)+(-33/10:ℝ)*(0)+(-9/10:ℝ)*(0))+((-2-(4/100000)*m 0)*(109/100:ℝ)+(1+(2/100000)*m 0)*(-9/5:ℝ)+(1)*(347/100:ℝ)+(0)*(519/100:ℝ)+(0)*(-33/10:ℝ)+(0)*(-9/10:ℝ)))
  rw [hm]
  ring

