theorem high_secant_positive (m : Fin 9 → ℝ) (y : Fin 6 → ℝ) (hone : m 8 = 1)
    (hm : ∀ k, highFeatureLower k ≤ m k ∧ m k ≤ highFeatureUpper k) :
    (1/2:ℝ)*(∑ i, (y i)^2) ≤ quadratic (-(highP*secant m+(secant m).transpose*highP)) y := by
  rw [← high_secant_binding m hone]
  apply quadratic_lower _ highComparison y
  · intro i
    have h := (affine_bounds (highCoefficients i i) _ _ m hm).1
    have ht := high_diagonal_table i
    linarith
  · intro i j hij
    have h := affine_bounds (highCoefficients i j) _ _ m hm
    have ht := high_off_table i j hij
    exact abs_le.mpr ⟨ht.1.trans h.1,h.2.trans ht.2⟩
  · exact high_row_table

end
end RAF1519.Reservoir
