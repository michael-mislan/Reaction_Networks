import Mathlib

namespace RAF1519.Reservoir
noncomputable section

def highEnergy (y : Fin 6 → ℝ) : ℝ :=
    (109/100:ℝ)*y 0*y 0 +
    (-18/5:ℝ)*y 0*y 1 +
    (347/50:ℝ)*y 0*y 2 +
    (519/50:ℝ)*y 0*y 3 +
    (-33/5:ℝ)*y 0*y 4 +
    (-9/5:ℝ)*y 0*y 5 +
    (597/100:ℝ)*y 1*y 1 +
    (-484/25:ℝ)*y 1*y 2 +
    (-729/25:ℝ)*y 1*y 3 +
    (937/50:ℝ)*y 1*y 4 +
    (247/50:ℝ)*y 1*y 5 +
    (827/50:ℝ)*y 2*y 2 +
    (2493/50:ℝ)*y 2*y 3 +
    (-796/25:ℝ)*y 2*y 4 +
    (-423/50:ℝ)*y 2*y 5 +
    (941/25:ℝ)*y 3*y 3 +
    (-2401/50:ℝ)*y 3*y 4 +
    (-319/25:ℝ)*y 3*y 5 +
    (1801/100:ℝ)*y 4*y 4 +
    (409/50:ℝ)*y 4*y 5 +
    (827/100:ℝ)*y 5*y 5

/-- Rational LDL identity for P-(1/1000)I; no floating point proof step. -/
theorem high_coercive (y : Fin 6 → ℝ) :
    (1/1000:ℝ)*((y 0)^2 + (y 1)^2 + (y 2)^2 + (y 3)^2 + (y 4)^2 + (y 5)^2) ≤ highEnergy y := by
  have hid : highEnergy y-(1/1000:ℝ)*((y 0)^2 + (y 1)^2 + (y 2)^2 + (y 3)^2 + (y 4)^2 + (y 5)^2) =
    (1089/1000:ℝ)*((1:ℝ)*y 0 + (-200/121:ℝ)*y 1 + (3470/1089:ℝ)*y 2 + (1730/363:ℝ)*y 3 + (-100/33:ℝ)*y 4 + (-100/121:ℝ)*y 5)^2 +
    (362249/121000:ℝ)*((1:ℝ)*y 1 + (-477280/362249:ℝ)*y 2 + (-726180/362249:ℝ)*y 3 + (473770/362249:ℝ)*y 4 + (118870/362249:ℝ)*y 5)^2 +
    (929640199/3260241000:ℝ)*((1:ℝ)*y 2 + (1582174830/929640199:ℝ)*y 3 + (-802195320/929640199:ℝ)*y 4 + (-221298030/929640199:ℝ)*y 5)^2 +
    (44172557761/929640199000:ℝ)*((1:ℝ)*y 3 + (-13826772790/44172557761:ℝ)*y 4 + (-5453465120/44172557761:ℝ)*y 5)^2 +
    (117992246646249/44172557761000:ℝ)*((1:ℝ)*y 4 + (257436929930/39330748882083:ℝ)*y 5)^2 +
    (94208071510508409/13110249627361000:ℝ)*((1:ℝ)*y 5)^2 := by
    unfold highEnergy
    ring
  have hn : (0:ℝ) ≤
    (1089/1000:ℝ)*((1:ℝ)*y 0 + (-200/121:ℝ)*y 1 + (3470/1089:ℝ)*y 2 + (1730/363:ℝ)*y 3 + (-100/33:ℝ)*y 4 + (-100/121:ℝ)*y 5)^2 +
    (362249/121000:ℝ)*((1:ℝ)*y 1 + (-477280/362249:ℝ)*y 2 + (-726180/362249:ℝ)*y 3 + (473770/362249:ℝ)*y 4 + (118870/362249:ℝ)*y 5)^2 +
    (929640199/3260241000:ℝ)*((1:ℝ)*y 2 + (1582174830/929640199:ℝ)*y 3 + (-802195320/929640199:ℝ)*y 4 + (-221298030/929640199:ℝ)*y 5)^2 +
    (44172557761/929640199000:ℝ)*((1:ℝ)*y 3 + (-13826772790/44172557761:ℝ)*y 4 + (-5453465120/44172557761:ℝ)*y 5)^2 +
    (117992246646249/44172557761000:ℝ)*((1:ℝ)*y 4 + (257436929930/39330748882083:ℝ)*y 5)^2 +
    (94208071510508409/13110249627361000:ℝ)*((1:ℝ)*y 5)^2 := by positivity
  rw [← hid] at hn
  linarith only [hn]

end
end RAF1519.Reservoir
