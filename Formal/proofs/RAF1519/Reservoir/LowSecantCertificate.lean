theorem low_energy_eq (y : Fin 6 → ℝ) : quadratic lowP y = lowEnergy y := by
  norm_num [quadratic,lowP,lowEnergy,sum_six,sum_nine]
  ring

theorem low_symmetric (i j : Fin 6) : lowP i j = lowP j i := by
  fin_cases i <;> fin_cases j <;> norm_num [lowP]

theorem low_binding_00 (m : Fin 9 → ℝ) (hm : m 8 = 1) :
    affine (lowCoefficients 0 0) m =
      (-(lowP*secant m+(secant m).transpose*lowP)) 0 0 := by
  simp only [affine,Matrix.mul_apply,Matrix.transpose_apply,Matrix.add_apply,Matrix.neg_apply,sum_six,sum_nine]
  change (257/2500000:ℝ)*m 0+(0:ℝ)*m 1+(0:ℝ)*m 2+(0:ℝ)*m 3+(0:ℝ)*m 4+(0:ℝ)*m 5+(0:ℝ)*m 6+(0:ℝ)*m 7+(51/50:ℝ)*m 8 = -(((103/100:ℝ)*(-2-(4/100000)*m 0)+(-51/100:ℝ)*(1+(2/100000)*m 0)+(103/50:ℝ)*(1)+(151/50:ℝ)*(0)+(-153/100:ℝ)*(0)+(-29/10:ℝ)*(0))+((-2-(4/100000)*m 0)*(103/100:ℝ)+(1+(2/100000)*m 0)*(-51/100:ℝ)+(1)*(103/50:ℝ)+(0)*(151/50:ℝ)+(0)*(-153/100:ℝ)+(0)*(-29/10:ℝ)))
  rw [hm]
  ring

