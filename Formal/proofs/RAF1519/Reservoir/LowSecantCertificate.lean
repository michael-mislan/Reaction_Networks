theorem low_secant_positive (m : Fin 9 → ℝ) (y : Fin 6 → ℝ) (hone : m 8 = 1)
    (hm : ∀ k, lowFeatureLower k ≤ m k ∧ m k ≤ lowFeatureUpper k) :
    (1/2:ℝ)*(∑ i, (y i)^2) ≤ quadratic (-(lowP*secant m+(secant m).transpose*lowP)) y := by
  rw [← low_secant_binding m hone]
  apply quadratic_lower _ lowComparison y
  · intro i
    have h := (affine_bounds (lowCoefficients i i) _ _ m hm).1
    have ht := low_diagonal_table i
    linarith
  · intro i j hij
    have h := affine_bounds (lowCoefficients i j) _ _ m hm
    have ht := low_off_table i j hij
    exact abs_le.mpr ⟨ht.1.trans h.1,h.2.trans ht.2⟩
  · exact low_row_table

end
