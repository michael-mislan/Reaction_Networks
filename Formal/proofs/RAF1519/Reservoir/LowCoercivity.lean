import Mathlib

namespace RAF1519.Reservoir
noncomputable section

def lowEnergy (y : Fin 6 → ℝ) : ℝ :=
    (103/100:ℝ)*y 0*y 0 +
    (-51/50:ℝ)*y 0*y 1 +
    (103/25:ℝ)*y 0*y 2 +
    (151/25:ℝ)*y 0*y 3 +
    (-153/50:ℝ)*y 0*y 4 +
    (-29/5:ℝ)*y 0*y 5 +
    (99/100:ℝ)*y 1*y 1 +
    (-4:ℝ)*y 1*y 2 +
    (-146/25:ℝ)*y 1*y 3 +
    (74/25:ℝ)*y 1*y 4 +
    (281/50:ℝ)*y 1*y 5 +
    (293/50:ℝ)*y 2*y 2 +
    (881/50:ℝ)*y 2*y 3 +
    (-447/50:ℝ)*y 2*y 4 +
    (-422/25:ℝ)*y 2*y 5 +
    (673/50:ℝ)*y 3*y 3 +
    (-683/50:ℝ)*y 3*y 4 +
    (-1293/50:ℝ)*y 3*y 5 +
    (233/25:ℝ)*y 4*y 4 +
    (199/25:ℝ)*y 4*y 5 +
    (7151/100:ℝ)*y 5*y 5

/-- Rational LDL identity for P-(1/1000)I; no floating point proof step. -/
theorem low_coercive (y : Fin 6 → ℝ) :
    (1/1000:ℝ)*((y 0)^2 + (y 1)^2 + (y 2)^2 + (y 3)^2 + (y 4)^2 + (y 5)^2) ≤ lowEnergy y := by
  have hid : lowEnergy y-(1/1000:ℝ)*((y 0)^2 + (y 1)^2 + (y 2)^2 + (y 3)^2 + (y 4)^2 + (y 5)^2) =
    (1029/1000:ℝ)*((1:ℝ)*y 0 + (-170/343:ℝ)*y 1 + (2060/1029:ℝ)*y 2 + (3020/1029:ℝ)*y 3 + (-510/343:ℝ)*y 4 + (-2900/1029:ℝ)*y 5)^2 +
    (252527/343000:ℝ)*((1:ℝ)*y 1 + (-335800/252527:ℝ)*y 2 + (-488160/252527:ℝ)*y 3 + (247540/252527:ℝ)*y 4 + (470830/252527:ℝ)*y 5)^2 +
    (328146679/757581000:ℝ)*((1:ℝ)*y 2 + (660313810/328146679:ℝ)*y 3 + (-338904870/328146679:ℝ)*y 4 + (-612903640/328146679:ℝ)*y 5)^2 +
    (29710535761/328146679000:ℝ)*((1:ℝ)*y 3 + (-14548848670/29710535761:ℝ)*y 4 + (-45062805870/29710535761:ℝ)*y 5)^2 +
    (173892960978859/29710535761000:ℝ)*((1:ℝ)*y 4 + (-76662824242720/173892960978859:ℝ)*y 5)^2 +
    (10071837602301550231/173892960978859000:ℝ)*((1:ℝ)*y 5)^2 := by
    unfold lowEnergy
    ring
  have hn : (0:ℝ) ≤
    (1029/1000:ℝ)*((1:ℝ)*y 0 + (-170/343:ℝ)*y 1 + (2060/1029:ℝ)*y 2 + (3020/1029:ℝ)*y 3 + (-510/343:ℝ)*y 4 + (-2900/1029:ℝ)*y 5)^2 +
    (252527/343000:ℝ)*((1:ℝ)*y 1 + (-335800/252527:ℝ)*y 2 + (-488160/252527:ℝ)*y 3 + (247540/252527:ℝ)*y 4 + (470830/252527:ℝ)*y 5)^2 +
    (328146679/757581000:ℝ)*((1:ℝ)*y 2 + (660313810/328146679:ℝ)*y 3 + (-338904870/328146679:ℝ)*y 4 + (-612903640/328146679:ℝ)*y 5)^2 +
    (29710535761/328146679000:ℝ)*((1:ℝ)*y 3 + (-14548848670/29710535761:ℝ)*y 4 + (-45062805870/29710535761:ℝ)*y 5)^2 +
    (173892960978859/29710535761000:ℝ)*((1:ℝ)*y 4 + (-76662824242720/173892960978859:ℝ)*y 5)^2 +
    (10071837602301550231/173892960978859000:ℝ)*((1:ℝ)*y 5)^2 := by positivity
  rw [← hid] at hn
  linarith only [hn]

end
end RAF1519.Reservoir
