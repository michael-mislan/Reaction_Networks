def rank (x : Nat) : Nat := (if ( : Nat).testBit x then 1 else 0) + (if ( : Nat).testBit x then 2 else 0) + (if ( : Nat).testBit x then 4 else 0) + (if ( : Nat).testBit x then 8 else 0) + (if ( : Nat).testBit x then 16 else 0)
