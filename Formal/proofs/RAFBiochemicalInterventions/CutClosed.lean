def pool1 (x : Nat) : Bool := ( : Nat).testBit x
def mask1 (x : Nat) : Bool := ( : Nat).testBit x
def keep1 (r : Row) : Bool := mask1 r.direction
def mask2 (x : Nat) : Bool := ( : Nat).testBit x
def keep2 (r : Row) : Bool := mask2 r.direction
def maximum : List Row := selected rows keep2
