theorem stage1 (S : List Row) (hs : Subrows S rows) (hr : RAF S food) : Subrows S (selected rows keep1) :=
  upper_raf rows food (fun _ => true) pool0 keep1 upper0 S (by simpa [selected] using hs) hr
theorem maximal (S : List Row) (hs : Subrows S rows) (hr : RAF S food) : Subrows S maximum :=
  upper_raf rows food keep1 pool1 keep2 upper1 S (stage1 S hs hr) hr
theorem sub : Subrows maximum rows := fun _ h => (List.mem_filter.mp h).1
theorem closed : ClosedRAF rows maximum food :=
