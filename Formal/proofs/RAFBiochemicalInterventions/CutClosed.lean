theorem forces (C : List Row) (hc : ClosedRAF rows C food) : Subrows maximum C :=
  Indexed.rank_forces rows food keep2 ParentTable.cutTree ParentTable.cut_tree_eq 5740 rank owner ranked C hc
theorem unique_closed (C : List Row) (hc : Subrows C rows) :
    ClosedRAF rows C food ↔ SameRows C maximum :=
  unique_closed_of_bounds rows maximum food raf forces maximal closed C hc
