def elementaryChoice (a b : Fin 2) (c d : Fin 3) : Fin 4 → Option (Fin 6) :=
  ![if a=0 then none else some 0,
    if b=0 then none else some 1,
    if c=0 then none else if c=1 then some 1 else some 2,
    if d=0 then none else if d=1 then some 0 else some 3]

def elementaryChoiceValid (a b : Fin 2) (c d : Fin 3) : Prop :=
  ¬(a=1 ∧ d=1) ∧ ¬(b=1 ∧ c=1)

def elementaryPatternMatrix (a b : Fin 2) (c d : Fin 3) : Matrix (Fin 4) (Fin 4) ℝ :=
  fun i j => match elementaryChoice a b c d j with
    | none => if i=j then -1 else 0
    | some r => if elementaryChoice a b c d i = none then 0 else
        (elementarySource.stoich i r : ℝ)

