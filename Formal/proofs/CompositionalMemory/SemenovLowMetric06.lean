theorem residual_bound (i j : Fin 8) (x : ℝ) (hl : -1 ≤ x) (hu : x ≤ 1) :
    |aeval x (qpolynomial (metricResidualPolynomial z P timeScale i j))| ≤ (rbound i j : ℝ) := by
  rw [qidentity_sound _ _ (replay.1 i j),qchebyshevSeries_semantics]
  exact rationalChebyshevPolynomial_abs_bound (rc i j) (rbound i j) (le_refl _) x hl hu

theorem force_bound (i : Fin 8) (x : ℝ) (hl : -1 ≤ x) (hu : x ≤ 1) :
