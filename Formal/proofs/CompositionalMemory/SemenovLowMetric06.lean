theorem replay :
    (∀ i j,qzeroCheck (qsub (metricResidualPolynomial z P timeScale i j) (qchebyshevSeries (rc i j)))=true) ∧
    (∀ i,qzeroCheck (qsub (forceResidualPolynomial z P timeScale i) (qchebyshevSeries (fc i)))=true) ∧
    (∀ i j,qzeroCheck (qsub (whitenedPolynomial P A i j) (qchebyshevSeries (wc i j)))=true) ∧
    (∀ i,(∑ j,rbound i j) ≤ (1/1000 : ℚ)) ∧
    ((∑ i,fbound i^2) ≤ (3/50000000000 : ℚ)^2) ∧
    (∀ i,(1/4 : ℚ) ≤ wlower i-∑ j,if j=i then 0 else wbound i j) := by native_decide

theorem symmetry_and_endpoints :
    (∀ i j,P i j=P j i) ∧
    (∀ i,qeval (-1) (z i)=zl i ∧ qeval 1 (z i)=zr i) ∧
    (∀ i j,qeval (-1) (P i j)=pl i j ∧ qeval 1 (P i j)=pr i j) ∧
    (0 ≤ leftTime ∧ leftTime<rightTime ∧ rightTime≤500 ∧ timeScale=2/(rightTime-leftTime)) := by native_decide

