theorem metric_symmetric (t : ℝ) (i j : Fin 8) : coefficientValue (pc i j) t=coefficientValue (pc j i) t := by
  have he := congrArg (fun l => aeval t (qpolynomial l)) (symmetry_and_endpoints.1 i j)
  simpa only [cache_P,qchebyshevSeries_semantics,coefficientValue] using he

theorem whitened_eq (t : ℝ) : coefficientMatrix wc t=rationalMatrix A*coefficientMatrix pc t*(rationalMatrix A).transpose :=
