theorem sixth_cap_slope_le_four (x : ℝ) (hl : 0 ≤ x) (hu : x ≤ 1) :
    12*x^5-12*x^11 ≤ 4 := by
  by_cases h : x ≤ 1/2
  · exact sixth_cap_slope_le_four_piece2 x (by norm_num; exact hl) h
  · by_cases hh : x ≤ 3/4
    · exact sixth_cap_slope_le_four_piece1 x (by linarith) hh
    · exact sixth_cap_slope_le_four_piece0 x (by linarith) (by norm_num; exact hu)

