private theorem sixth_cap_slope_le_four_piece0 (x : ℝ) (hl : (3 / 4 : ℝ) ≤ x) (hu : x ≤ (1 / 1 : ℝ)) :
    12*x^5-12*x^11 ≤ 4 := by
  have ha : 0 ≤ x-(3 / 4 : ℝ) := sub_nonneg.mpr hl
  have hb : 0 ≤ (1 / 1 : ℝ)-x := sub_nonneg.mpr hu
  have hid : 4-(12*x^5-12*x^11) =
      (6959044 / 1 : ℝ)*(x-(3 / 4 : ℝ))^0*((1 / 1 : ℝ)-x)^11 +
      (64437392 / 1 : ℝ)*(x-(3 / 4 : ℝ))^1*((1 / 1 : ℝ)-x)^10 +
      (261346240 / 1 : ℝ)*(x-(3 / 4 : ℝ))^2*((1 / 1 : ℝ)-x)^9 +
      (609242880 / 1 : ℝ)*(x-(3 / 4 : ℝ))^3*((1 / 1 : ℝ)-x)^8 +
      (909404160 / 1 : ℝ)*(x-(3 / 4 : ℝ))^4*((1 / 1 : ℝ)-x)^7 +
      (947331072 / 1 : ℝ)*(x-(3 / 4 : ℝ))^5*((1 / 1 : ℝ)-x)^6 +
      (798965760 / 1 : ℝ)*(x-(3 / 4 : ℝ))^6*((1 / 1 : ℝ)-x)^5 +
      (661585920 / 1 : ℝ)*(x-(3 / 4 : ℝ))^7*((1 / 1 : ℝ)-x)^4 +
      (522977280 / 1 : ℝ)*(x-(3 / 4 : ℝ))^8*((1 / 1 : ℝ)-x)^3 +
      (309329920 / 1 : ℝ)*(x-(3 / 4 : ℝ))^9*((1 / 1 : ℝ)-x)^2 +
      (109051904 / 1 : ℝ)*(x-(3 / 4 : ℝ))^10*((1 / 1 : ℝ)-x)^1 +
      (16777216 / 1 : ℝ)*(x-(3 / 4 : ℝ))^11*((1 / 1 : ℝ)-x)^0 := by ring
  have hn : 0 ≤ 4-(12*x^5-12*x^11) := by
    rw [hid]
    positivity
  linarith only [hn]

