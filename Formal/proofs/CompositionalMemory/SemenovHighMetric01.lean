theorem replay :
    (∀ i j,qzeroCheck (qsub (metricResidualPolynomial z P timeScale i j) (qchebyshevSeries (rc i j)))=true) ∧
    (∀ i,qzeroCheck (qsub (forceResidualPolynomial z P timeScale i) (qchebyshevSeries (fc i)))=true) ∧
    (∀ i j,qzeroCheck (qsub (whitenedPolynomial P A i j) (qchebyshevSeries (wc i j)))=true) ∧
    (∀ i,(∑ j,rbound i j) ≤ (1/1000 : ℚ)) ∧
    ((∑ i,fbound i^2) ≤ (1/20000000000 : ℚ)^2) ∧
    (∀ i,(1/4 : ℚ) ≤ wlower i-∑ j,if j=i then 0 else wbound i j) := by native_decide

theorem symmetry_and_endpoints :
    (∀ i j,P i j=P j i) ∧
    (∀ i,qeval (-1) (z i)=zl i ∧ qeval 1 (z i)=zr i) ∧
    (∀ i j,qeval (-1) (P i j)=pl i j ∧ qeval 1 (P i j)=pr i j) ∧
    (0 ≤ leftTime ∧ leftTime<rightTime ∧ rightTime≤500 ∧ timeScale=2/(rightTime-leftTime)) := by native_decide

theorem geometry : MetricGeometryChecks zc pc wc A nr eta radius margin (5148/1 : ℚ) (713/1000 : ℚ) (1290/1 : ℚ) := by native_decide

theorem cache_P (i j : Fin 8) : P i j=qchebyshevSeries (pc i j) := by
  simp only [P,pCache,cached_ofFn_value]

theorem metric_symmetric (t : ℝ) (i j : Fin 8) : coefficientValue (pc i j) t=coefficientValue (pc j i) t := by
  have he := congrArg (fun l => aeval t (qpolynomial l)) (symmetry_and_endpoints.1 i j)
  simpa only [cache_P,qchebyshevSeries_semantics,coefficientValue] using he

theorem whitened_eq (t : ℝ) : coefficientMatrix wc t=rationalMatrix A*coefficientMatrix pc t*(rationalMatrix A).transpose :=
  whitened_replay_sound pc wc P A cache_P replay.2.2.1 t

theorem tube_radius (t : ℝ) (hl : -1 ≤ t) (hu : t ≤ 1) (x : Fin 8 → ℝ)
    (hx : matrixEnergy (coefficientMatrix pc t) x ≤ (eta : ℝ)) : vectorSquares x ≤ (radius : ℝ)^2 := by
  exact geometry_tube_radius zc pc wc A nr eta radius margin (5148/1 : ℚ) (713/1000 : ℚ) (1290/1 : ℚ) geometry t hl hu
    (whitened_eq t) (coefficient_congruence_symmetric pc wc A t (whitened_eq t) (metric_symmetric t)) x hx

theorem residual_bound (i j : Fin 8) (x : ℝ) (hl : -1 ≤ x) (hu : x ≤ 1) :
    |aeval x (qpolynomial (metricResidualPolynomial z P timeScale i j))| ≤ (rbound i j : ℝ) := by
  rw [qidentity_sound _ _ (replay.1 i j),qchebyshevSeries_semantics]
  exact rationalChebyshevPolynomial_abs_bound (rc i j) (rbound i j) (le_refl _) x hl hu

theorem force_bound (i : Fin 8) (x : ℝ) (hl : -1 ≤ x) (hu : x ≤ 1) :
    |aeval x (qpolynomial (forceResidualPolynomial z P timeScale i))| ≤ (fbound i : ℝ) := by
  rw [qidentity_sound _ _ (replay.2.1 i),qchebyshevSeries_semantics]
  exact rationalChebyshevPolynomial_abs_bound (fc i) (fbound i) (le_refl _) x hl hu

